# Server Port
PORT=5000

# Node Environment: development | production | test
NODE_ENV=development

# Allowed Frontend CORS Origin (Never use wildcard with credentials)
CORS_ORIGIN=http://localhost:4200

# Cookie SameSite Configuration: lax (recommended for same-domain) | none (requires HTTPS in production for cross-domain)
COOKIE_SAMESITE=lax

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@<cluster-url>/hirehub?retryWrites=true&w=majority
MONGODB_URI=

# JSON Web Token Secret & Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Initial Administrator Provisioning (Optional, for npm run seed:admin)
ADMIN_NAME=HireHub Administrator
ADMIN_EMAIL=admin@hirehub.example
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_123!

# File Upload Storage (Optional custom directory, defaults to server/uploads/resumes outside web root)
# UPLOAD_DIR=uploads/resumes

# SMTP Email Delivery Configuration (Optional - for Email Worker)
# If unconfigured, in-app notifications still function normally, while email jobs are logged as unconfigured.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
